          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=You are a customer support assistant.\n\nAnalyze the following customer message and return the result in \n\nCustomer message:\n{{ $json.body.message }}\n\nClassify the message into exactly one of these categories:\n- inquiry\n- complaint\n- technical_issue\n- other\n\nDetermine the priority:\n- low\n- medium\n- high\n\nReturn exactly these fields:\n{\n  \"category\": \"category\",\n  \"priority\": \"priority\",\n  \"summary\": \"A short summary of the customer's issue\",\n  \"suggested_reply\": \"A polite and helpful reply to the customer\"\n}\n\nThe summary and suggested_reply should be written in Traditional Chinese.\nReturn only valid JSON without Markdown formatting."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        208,
        0
      ],
      "id": "fca4f411-9989-4259-8b90-a4700da519d1",
      "name": "AI Customer Analysis"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first(); //取的上一個Node傳過來的第一筆資料\n\nconst text = input.json.output[0].content[0].text; //沿著左邊input看到的資料結構排序\n\nconst parsed = JSON.parse(text);\n\n//原本是一整串字串沒有排序的輸出，但改正上面那樣就會變成有格式地輸出\n\nconst webhookData = $('Customer Request').first().json.body;\n// 取得最前面 Webhook 收到的原始客戶資料\n\nreturn[\n  {\n    JSON:{\n      name:webhookData.name,\n      email:webhookData.email,\n      message:webhookData.message,\n\n      category:parsed.category,\n      priority:parsed.priority,\n      summary:parsed.summary,\n      suggested_reply:parsed.suggested_reply\n    }\n  }\n];\n//把整理好的 JSON 當成這個 Node 的 Output\n//右邊不再是一大串 text，而是可以拆開。"
      },
      "type": "n8n-nodes-base.code",
