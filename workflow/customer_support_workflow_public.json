    {
      "parameters": {
        "jsCode": "const input = $input.first(); //取的上一個Node傳過來的第一筆資料\n\nconst text = input.json.output[0].content[0].text; //沿著左邊input看到的資料結構排序\n\nconst parsed = JSON.parse(text);\n\n//原本是一整串字串沒有排序的輸出，但改正上面那樣就會變成有格式地輸出\n\nconst webhookData = $('Customer Request').first().json.body;\n// 取得最前面 Webhook 收到的原始客戶資料\n\nconst categoryCorrect =\n  parsed.category === webhookData.expected_category;\n\nconst priorityCorrect =\n  parsed.priority === webhookData.expected_priority;\n\nreturn[\n  {\n    JSON:{\n      name:webhookData.name,\n      email:webhookData.email,\n      message:webhookData.message,\n      \n      expected_category: webhookData.expected_category,\n      predicted_category: parsed.category,\n      category_correct: categoryCorrect,\n\n      expected_priority: webhookData.expected_priority,\n      predicted_priority: parsed.priority,\n      priority_correct: priorityCorrect,\n\n      summary:parsed.summary,\n      suggested_reply:parsed.suggested_reply\n    }\n  }\n];\n//把整理好的 JSON 當成這個 Node 的 Output\n//右邊不再是一大串 text，而是可以拆開。"
      },
